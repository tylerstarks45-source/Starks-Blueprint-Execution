modules = ["nodejs-24", "python-3.11", "rust", "rust-stable", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
STRIPE_PRICE_BUILDER = "price_1TeMFuBoFvPsJhMcnga2xMnO"
STRIPE_PRICE_OPERATOR = "price_1TeMFtBoFvPsJhMcYWn1WPe7"
